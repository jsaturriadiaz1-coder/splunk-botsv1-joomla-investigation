index=botsv1 earliest=0 latest=now sourcetype=stream:http
| spath path=src_ip output=source_address
| spath path=dest_ip output=destination_address
| spath path=http_method output=method
| spath path=uri_path output=request_path
| spath path=status output=response_status
| spath path=src_content output=form_data
| spath path=dest_content output=response_body
| search destination_address="192.168.250.70" request_path="/joomla/administrator/index.php" (source_address="23.22.63.114" OR source_address="40.80.148.42")
| rex field=form_data "(?:^|&)username=(?<username>[^&]*)"
| rex field=form_data "(?:^|&)passwd=(?<password_candidate>[^&]*)"
| rex field=response_body "(?i)<title>(?<page_title>[^<]*)</title>"
| eval uploader_password=if(source_address="40.80.148.42" AND method="POST",password_candidate,null())
| eval panel_time=if(source_address="23.22.63.114" AND method="GET" AND response_status=200 AND like(page_title,"%Control Panel%"),_time,null())
| eventstats values(uploader_password) as comparison_password min(panel_time) as first_control_panel_time
| where source_address="23.22.63.114" AND method="POST" AND username="admin" AND isnotnull(password_candidate)
| sort 0 _time
| streamstats count as candidate_position
| eval matches_uploader=if(password_candidate=comparison_password,"yes","no")
| eventstats max(eval(if(_time<first_control_panel_time,_time,null()))) as preceding_post_time count(eval(_time>first_control_panel_time)) as posts_after_control_panel max(_time) as last_post_time
| where matches_uploader="yes" OR _time=preceding_post_time
| eval closest_preceding_post=if(_time=preceding_post_time,"yes","no"), seconds_before_control_panel=round(first_control_panel_time-_time,6), guessing_seconds_after_access=round(last_post_time-first_control_panel_time,6)
| convert ctime(first_control_panel_time) ctime(last_post_time)
| table _time candidate_position matches_uploader closest_preceding_post seconds_before_control_panel first_control_panel_time posts_after_control_panel last_post_time guessing_seconds_after_access
